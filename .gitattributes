# Keep repository text files portable across Windows and Linux.
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.csv  text eol=lf
*.txt  text eol=lf

# Binary artifacts must never be line-ending normalized.
*.parquet binary
*.pkl     binary
*.pickle  binary
*.npy     binary
*.npz     binary
